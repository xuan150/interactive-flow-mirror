// `Person` is generated by VFX Graph from the C# struct FlowMirror.Person ([VFXType], matched by class name).
// Don't declare your own struct here: the buffer is declared before this file is included.

/// Hidden
float Influence(float2 p, float2 center, float radius)
{
    // 1 at the person, 0 at radius; squared so the core is strong and the edge eases out.
    float w = 1 - smoothstep(0, radius, length(p - center));
    return w * w;
}

/// persons: the Persons property (GraphicsBuffer)
/// count: the PersonCount property
/// rest: the point's home position (the two Lerps)
/// wave: idle undulation offset in y (noise × mask)
/// radius: how far each vortex reaches
/// maxAngle: twist at the center, in radians (3.14 = half a turn)
/// pull: 0 ~ 1, how much points are drawn toward the person
/// glow: extra brightness near a person (0 = none)
/// streak: brightness of the light flowing into the center (0 = none)
/// streakSpacing: distance between two streaks
/// streakSpeed: how fast streaks fall into the center
/// time: Total Time
void Vortex(inout VFXAttributes attributes, StructuredBuffer<Person> persons, int count, float2 rest, float wave,
            float radius, float maxAngle, float pull, float glow, float streak, float streakSpacing, float streakSpeed,
            float time)
{
    int n = min(count, 8);

    // Pass 1: inside a vortex the idle wave calms down to 20%, so the spiral keeps a stable shape.
    float claim = 0;
    for (int i = 0; i < n; i++)
        claim += Influence(rest, persons[i].position, radius);
    float2 p = rest + float2(0, wave * (1 - 0.8 * saturate(claim)));

    // Pass 2: pull toward each person and twist around them. The shape is fixed; motion comes from light.
    float brightness = 1;
    for (int j = 0; j < n; j++)
    {
        float2 center = persons[j].position;
        float2 offset = p - center;
        float w = Influence(p, center, radius);

        offset *= 1 - pull * w;

        float s, c;
        sincos(maxAngle * w, s, c);
        offset = float2(offset.x * c - offset.y * s, offset.x * s + offset.y * c);
        p = center + offset;

        // Light streaks: bright bands at fixed distances that shrink toward the center over time,
        // so light runs along the spiral arms into the person. pow() keeps each band thin.
        float phase = length(offset) / streakSpacing + time * streakSpeed + persons[j].id * 0.37;
        float band = pow(0.5 + 0.5 * sin(phase * 6.2831853), 8);

        brightness += w * (glow + streak * band);
    }

    // Assign whole attributes: VFX only detects writes like `attributes.position =` or a one-letter swizzle,
    // so `attributes.position.xy = p` would silently be treated as read-only and discarded.
    attributes.position = float3(p, 0);
    // Output color blocks use Multiply composition, so this brightness multiplies whatever they set.
    attributes.color = brightness;
}
